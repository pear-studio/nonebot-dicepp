# Git
.git
.gitignore

# Python
**/__pycache__
**/*.py[cod]
**/*$py.class
*.so
.Python
.venv
venv
env
**/*.egg-info

# IDE
.vscode
.idea
.cursor
.trae
.claude

# 测试
tests
.pytest_cache
.coverage
htmlcov

# 其他
.temp
*.md
*.log
Dockerfile*
docker-compose*

# Secrets — 防止本地配置文件被打包进 Docker 镜像
.env
config/nonebot.env
config/secrets.json
config/user.json
config/bots/*.json
!config/bots/_template.json
# Manager 运行时凭据与状态 — 容器内 root 写入后本机构建无法读取
manager/control/
manager/state/
data/
content/
