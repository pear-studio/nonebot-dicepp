  "contracts": [
    {
      "name": "update_guard_request",
      "medium": "json-file",
      "producer": "WindowsVelopackUpgradeAdapter.switch",
      "consumers": ["UpdateGuard.run_guard", "Manager startup resume"],
      "format_versions": [2],
      "verification_status": "verified",
      "support_window": "all published v2 layouts",
      "compatibility_fixtures": [
        "tests/fixtures/update_guard/v2-direct.json",
        "tests/fixtures/update_guard/rc17-staged.json"
      ]
    },
    {
      "name": "update_guard_markers",
      "medium": "json-files",
      "producer": "UpdateGuard and target Manager",
      "consumers": ["UpdateGuard", "source Manager", "target Manager"],
      "format_versions": [2],
      "verification_status": "verified",
      "support_window": "while a v2 transaction is recoverable",
      "compatibility_fixtures": [
        "tests/fixtures/update_guard/v2-direct.json",
        "tests/fixtures/update_guard/rc17-staged.json"
      ]
    },
    {
      "name": "manager_upgrade_journal",
      "medium": "sqlite-row",
