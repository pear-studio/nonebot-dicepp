      "format_versions": [2],
      "verification_status": "verified",
      "support_window": "current release discovery contract",
      "compatibility_fixtures": []
    },
    {
      "name": "windows_bundle_manifest",
      "medium": "json-in-zip",
      "producer": "build_velopack_bundle.py",
      "consumers": ["ReleaseManager", "WindowsVelopackUpgradeAdapter"],
      "format_versions": [1],
      "verification_status": "verified",
      "support_window": "current automatic-upgrade source window",
      "compatibility_fixtures": []
    },
    {
      "name": "linux_bundle_manifest",
      "medium": "json-in-zip",
      "producer": "build_linux_bundle.sh",
      "consumers": ["ReleaseManager", "LinuxDockerUpgradeAdapter"],
      "format_versions": [1],
      "verification_status": "verified",
      "support_window": "current automatic-upgrade source window",
      "compatibility_fixtures": []
    },
    {
      "name": "deployment_schema",
      "medium": "integer-in-health-and-manifests",
      "producer": "Manager and release build",
      "consumers": ["ManagerClient", "ReleaseManager", "UpgradeCoordinator"],
      "format_versions": [2],
      "verification_status": "verified",
      "support_window": "current deployment topology",
      "compatibility_fixtures": []
    }
  ]
}
